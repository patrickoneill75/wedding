{
  // Worker with static assets: public/ is served by Cloudflare's asset layer and
  // src/worker.js handles /api/*, which is what keeps every secret out of the browser.
  // "name" must match the Worker's name in the Cloudflare dashboard (Workers & Pages).
  // `wrangler secret put` and `wrangler deploy` target whatever this says, and a
  // mismatch silently creates a second, never-served Worker instead of erroring.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    // Every request reaches the Worker first: it serves the copied Zola pages at "/",
    // "/travel" and so on, and hands everything else to these static files.
    "run_worker_first": true
  },

  // The Zola wedding website copied onto the home page (Settings can override it), and
  // the repo whose "Refresh website from Zola" workflow the Settings button starts.
  "vars": {
    "ZOLA_URL": "https://www.zola.com/wedding/patrickandkaitlyn2027",
    "GITHUB_REPO": "patrickoneill75/wedding",
    // The site's address: the expense form is always PUBLIC_URL/submit, and
    // patrickandkaitlyn.com redirects here.
    "PUBLIC_URL": "https://www.patrickandkaitlyn.com"
  },

  // Everything lives in one D1 database: guests, expenses, payments, price history,
  // settings and the Google Drive connection. The Worker creates its own tables on
  // first request (src/db.js), so there is no migration step. Create the database
  // once (see SETUP.md) and paste its ID below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding",
      "database_id": "c56f493c-47d0-4646-be08-2d5ebb1b0b2f"
    }
  ],

  // Pull request previews (`wrangler preview`, run by Cloudflare's build for every
  // branch but main). They get their own empty database, so a branch's schema changes
  // (src/db.js migrations) never run on the real guest list before it merges. PUBLIC_URL
  // is blank so a preview stays on its own address instead of redirecting to the site.
  // Previews have none of the production secrets, so nobody can sign in to one: they
  // show that a branch builds and starts.
  "previews": {
    "vars": {
      "ZOLA_URL": "https://www.zola.com/wedding/patrickandkaitlyn2027",
      "GITHUB_REPO": "patrickoneill75/wedding",
      "PUBLIC_URL": ""
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "wedding-preview",
        "database_id": "5933bafb-4b05-4ce4-9ce9-fbce6762b860"
      }
    ]
  },

  // The site's own domain (registered at Hover, DNS on Cloudflare). Cloudflare creates
  // the DNS records and certificates for these on deploy; the domain must already be
  // active in this Cloudflare account. The workers.dev address keeps working too: the
  // "Refresh website from Zola" workflow and older expense-form links use it.
  "routes": [
    { "pattern": "patrickandkaitlyn.com", "custom_domain": true },
    { "pattern": "www.patrickandkaitlyn.com", "custom_domain": true }
  ],
  "workers_dev": true,

  // Every five minutes: push guests/expenses/payments to Google Drive if anything
  // changed since the last sync (src/sync.js).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
